# OpenAI — server-side only. Never commit real keys.
OPENAI_API_KEY=sk-your-project-key-here
OPENAI_MODEL=gpt-5.6-luna

# Shared Exploration Graph persistence.
# Current Vercel deployments use BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically
# when a private Blob store is connected to the project.
# For local development only, a legacy/static token can still be used:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# Human-manageable Graph Admin password.
# Entered once when opening Graph Admin; the server returns an HttpOnly session cookie.
# The password is never stored in localStorage/sessionStorage and is not sent with each edit.
GRAPH_ADMIN_PASSWORD=choose-a-strong-memorable-password
